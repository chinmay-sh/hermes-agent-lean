@@ -298,6 +298,17 @@
 RUN uv pip install --no-cache-dir \
     "python-telegram-bot[webhooks]==22.8"
 
+# ---------- Kapso variant only (build workflow adds plugins/platforms/kapso/) ----------
+# Bakes aiohttp for the bundled Kapso WhatsApp platform plugin
+# (https://github.com/gokapso/hermes-agent-plugin), which the build workflow
+# copies into plugins/platforms/kapso/ before this Dockerfile runs so Hermes
+# discovers it as a lazy-loaded bundled platform (env-gated on KAPSO_API_KEY,
+# same as every other bundled platform here). Pinned to the same aiohttp
+# version already vetted elsewhere in pyproject.toml rather than the
+# plugin's own looser `aiohttp>=3.9`, so this stays the one aiohttp source
+# of truth for the image.
+RUN uv pip install --no-cache-dir "aiohttp==3.14.3"
+
 # ---------- Bot Screen X socket directory ----------
 # Xvnc would create this itself (/tmp is 1777); pre-creating it keeps ownership
 # deterministic when HERMES_UID is remapped between boots.
