HERMES_IMAGE=<dockerhub-user>/hermes-agent-lean:v2026.9.14

HERMES_DASHBOARD_PUBLIC_URL=https://hermes.example.com
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=
# Signs session cookies so logins survive restarts. Generate with: openssl rand -hex 32
HERMES_DASHBOARD_BASIC_AUTH_SECRET=

# Cloudflare Zero Trust → Networks → Tunnels → your tunnel → token
TUNNEL_TOKEN=
